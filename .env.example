# Telegram credentials from https://my.telegram.org/auth
API_ID=1821196
API_HASH=your_api_hash_here

# Name of the Telethon session file, without the .session extension
SESSION_NAME=news_classifier

# Directory with the fine-tuned RuBERT model and its tokenizer
MODEL_PATH=model

# DuckDB file holding the recently seen posts
DB_PATH=messages.db

# Category taxonomy and the forum state written by the bot
TAXONOMY_PATH=config/categories.yaml
FORUM_STATE_PATH=config/forum_state.yaml

# Title of the forum created on the first run
FORUM_TITLE=News

# Hours a post stays a duplicate candidate
MESSAGE_LIFETIME=2

# Jaccard score above which two posts count as the same news
SIMILARITY_THRESHOLD=0.1

# spaCy pipeline used for lemmatization
SPACY_MODEL=ru_core_news_sm

# Logging
DISABLE_LOGGING=false
LOG_LEVEL=INFO
LOG_PATH=
